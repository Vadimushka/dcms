# Версия PHP для стенда: движок требует 8.1+, целевая — 8.5.
# Смена версии требует пересборки: docker compose build php
PHP_VERSION=8.5

# Под каким пользователем работает PHP-FPM. Должен совпадать с владельцем
# каталога проекта (id -u / id -g), иначе движок не запишет sys/ini и sys/tmp.
UID=1000
GID=1000

# Порты публикуются только на 127.0.0.1.
# На машине заняты 80, 443, 3306, 5432, 8080 — их не использовать.
APP_PORT=8090
PHPMYADMIN_PORT=8091
DB_PORT=33061

DB_DATABASE=dcms
DB_USERNAME=dcms
DB_PASSWORD=dcms
