DirectoryIndex index.php index.html

<IfModule mod_php.c>
    # ограничения на выгрузку файлов
    php_value upload_max_filesize 100M
    php_value post_max_size 100M

    ####################################################
    # отключаем вывод ошибок
    php_flag display_errors off
    php_value arg_separator.output &amp;
    # передача сессии в URL устарела в PHP 8.5 и утекает через Referer
    php_flag session.use_trans_sid off
    php_flag session.cookie_lifetime off
    # включаем встроенное сжатие
    #php_flag zlib.output_compression on
    # решение проблем с кодировкой
    php_value default_charset UTF-8
    ####################################################
</IfModule>

Options -Indexes

# Каталоги, которых не должно быть видно снаружи: зависимости (исходники
# библиотек и их точки входа), документация выката, конфигурация веб-сервера
# и набор проверок. В докрут они попадают при выкате копированием каталога.
RedirectMatch 404 ^/(vendor|docs|docker|tests)/

# Файлы разработки в корне сайта. Правило намеренно ограничено корнем:
# в обменнике такие расширения принадлежат пользовательским файлам.
RedirectMatch 404 ^/(composer\.(json|lock)|docker-compose\.ya?ml|phpstan.*\.neon|phpstan-bootstrap\.php|package(-lock)?\.json)$
RedirectMatch 404 ^/[^/]+\.(md|neon|dist|lock|sh|sql|bak|old|orig|swp|ya?ml)$

# Точки, начинающиеся с точки: .env, .git, редакторские бэкапы
RedirectMatch 404 (^|/)\.

# переопределяем страницы ошибок
ErrorDocument 400 /error.php?err=400
ErrorDocument 401 /error.php?err=401
ErrorDocument 402 /error.php?err=402
ErrorDocument 403 /error.php?err=403
ErrorDocument 404 /error.php?err=404
ErrorDocument 500 /error.php?err=500
ErrorDocument 502 /error.php?err=502

<IfModule mod_rewrite.c>
    RewriteEngine on
    RewriteBase /
    RewriteCond %{SCRIPT_FILENAME} !-f
    RewriteRule ^([^/]+)$ pages/$1 [L,QSA]
</IfModule>