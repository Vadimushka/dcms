# Что не попадает в архив дистрибутива (git archive и автоархивы GitHub).
# Список повторяет исключения выката: посетителю движка не нужны стенд,
# проверки и файлы сборки, а держать их в поставке — лишняя поверхность.
/.github         export-ignore
/.gitattributes  export-ignore
/.gitignore      export-ignore
/deploy          export-ignore
/docker          export-ignore
/docker-compose.yml export-ignore
/docs            export-ignore
/tests           export-ignore
/composer.json   export-ignore
/composer.lock   export-ignore
/phpstan.neon    export-ignore
/phpstan-baseline.neon export-ignore
/phpstan-bootstrap.php export-ignore
/.env.example    export-ignore
/desktop.ini     export-ignore

# Переводы и документы движка — текст, а не двоичные данные
*.lng text
*.tpl text
